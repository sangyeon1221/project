def solution(code):
    mode = 0
    ret = ''
    for i in range(len(code)):
        if code[i] == '1':
            mode = 1 - mode
        elif mode == 0 and i % 2 == 0:
            ret += code[i]
        elif mode == 1 and i % 2 == 1:
            ret += code[i]
    return 'EMPTY' if ret == '' else ret

''' =는 대입 연산자고 ==는 비교연산자이므로 잘 파악하여 사용해야한다, 처음에는 mode와 ret을 함수안의 변수로 받았었는데 처음에 초기화를 해둔다면 따로 받을 필요가없다
for i in range(n)이라면 0~n-1까지의 범위이다, else if가 아닌 elif를 사용해야한다, if code[i] == 1 이라면 정수를 나타내는 것이고, 내가 구해야하는것은 문자열 1이므로
'1'으로 써야한다.'''
